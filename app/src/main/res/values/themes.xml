<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window-level theme. Everything visible is drawn by Compose; this only sets the
         background shown before the first frame so there is no white flash. -->
    <style name="Theme.RecipeFinder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
